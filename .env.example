# Bhumi-Raksha AI — environment configuration (EXAMPLE)
# Copy to `.env` and adjust. NEVER commit a real .env — no API keys, DB
# passwords, or secrets in source control (project rule §14).

APP_ENV=development
LOG_LEVEL=INFO

# --- Database (PostgreSQL + PostGIS) ---
# psycopg 3 driver -> URL scheme MUST be postgresql+psycopg://
DATABASE_URL=postgresql+psycopg://bhumi:bhumi@localhost:5432/bhumi_raksha
# Consumed by docker-compose to initialise the db container:
POSTGRES_USER=bhumi
POSTGRES_PASSWORD=bhumi
POSTGRES_DB=bhumi_raksha

# --- Weather data provider (Mock -> Real adapter seam) ---
# mock       = DEMO / SIMULATED rainfall (default, offline-safe)
# open_meteo = real, keyless Open-Meteo API
WEATHER_PROVIDER=mock

# --- Object storage (MinIO / S3-compatible) ---
# Local dev defaults below match docker-compose; override in real deployments.
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=bhumi-media

# --- CORS (frontend dev-server origins) ---
# The React/Vite dashboard runs on a separate origin in dev and calls this API.
# pydantic-settings parses a JSON array for list-typed vars.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- Risk engine weights (PROTOTYPE demo weights — NOT government-standard) ---
# Relative factor importance; auto-normalized to sum to 1 at use time. These are
# illustrative prototype weights (rule §5/§9), overridable per deployment.
RISK_W_RAINFALL=0.30
RISK_W_SLOPE=0.25
RISK_W_HISTORICAL=0.20
RISK_W_SOIL=0.10
RISK_W_TERRAIN=0.05
RISK_W_EXPOSURE=0.10
