# Bhumi-Raksha AI — environment configuration (EXAMPLE)
# Copy to `.env` and adjust. NEVER commit a real .env — no API keys, DB
# passwords, or secrets in source control (project rule §14).

APP_ENV=development
LOG_LEVEL=INFO
# Backend HTTP port. Consumed by the container / start command
# (uvicorn --port ${PORT:-8000}), NOT read by the app itself. Most PaaS
# platforms (Render, Railway, Cloud Run) inject PORT automatically.
PORT=8000

# --- Database (PostgreSQL + PostGIS) ---
# psycopg 3 driver -> URL scheme should be postgresql+psycopg://
# Hosted Postgres (Render/Railway/Neon/Supabase/Heroku) usually hands out a bare
# postgres:// or postgresql:// URL; the app auto-rewrites those two schemes to
# postgresql+psycopg:// so a copy-pasted provider URL works as-is. The target DB
# MUST have the PostGIS extension (the migration runs CREATE EXTENSION postgis).
DATABASE_URL=postgresql+psycopg://bhumi:bhumi@localhost:5432/bhumi_raksha
# Consumed by docker-compose to initialise the db container:
POSTGRES_USER=bhumi
POSTGRES_PASSWORD=bhumi
POSTGRES_DB=bhumi_raksha

# --- Weather data provider (Mock -> Real adapter seam) ---
# mock       = DEMO / SIMULATED rainfall (default, offline-safe)
# open_meteo = real, keyless Open-Meteo API
WEATHER_PROVIDER=mock

# --- Object storage (MinIO / S3-compatible) ---
# Local dev defaults below match docker-compose; override in real deployments.
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=bhumi-media

# --- CORS (browser origins allowed to call the API) ---
# The React/Vite dashboard runs on a separate origin and calls this API.
# pydantic-settings parses a JSON array for list-typed vars.
# In production, set this to your deployed frontend origin(s), e.g.:
#   CORS_ORIGINS=["https://bhumi-raksha.vercel.app"]
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- Risk engine weights (PROTOTYPE demo weights — NOT government-standard) ---
# Relative factor importance; auto-normalized to sum to 1 at use time. These are
# illustrative prototype weights (rule §5/§9), overridable per deployment.
RISK_W_RAINFALL=0.30
RISK_W_SLOPE=0.25
RISK_W_HISTORICAL=0.20
RISK_W_SOIL=0.10
RISK_W_TERRAIN=0.05
RISK_W_EXPOSURE=0.10
