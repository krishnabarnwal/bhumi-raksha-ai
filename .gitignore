# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.installed.cfg

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- Secrets / config (NEVER commit — see project rule §14) ---
.env
.env.*
!.env.example

# --- Test / tooling caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Local data volumes (docker) ---
pgdata/
miniodata/

# --- IDE / OS ---
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# --- Node / frontend build (also covered by frontend/.gitignore) ---
node_modules/
dist-ssr/
*.local

# --- Local runtime data (uploaded field-report media — recreated at runtime) ---
backend/media/

# --- Local agent / editor tooling (not part of the app) ---
.claude/
