# Bhumi-Raksha AI — frontend environment (EXAMPLE)
# Copy to `.env` for local dev, or set this in your host's build-time env.
#
# IMPORTANT: Vite inlines VITE_* variables at BUILD time. VITE_API_BASE must be
# set BEFORE `npm run build`; changing it afterwards requires a rebuild. It is
# not read at runtime by the static bundle.

# Base URL of the backend API (no trailing slash — a trailing slash is stripped).
# Local dev default:
VITE_API_BASE=http://localhost:8000

# Production example (set to your deployed backend origin):
# VITE_API_BASE=https://bhumi-raksha-api.onrender.com
